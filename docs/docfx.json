{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": ["**/*.csproj"]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "exclude": ["_site/**", "superpowers/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "Typographer",
      "_appTitle": "Typographer",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/gberikov/Typographer",
        "branch": "master"
      }
    }
  }
}
